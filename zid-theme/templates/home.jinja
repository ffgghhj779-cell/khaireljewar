{% extends 'layout.jinja' %}
{% set en = store.language == 'en' %}

{% block title %}
  {% if en %}{{ store.name }} — Neighborly goodness{% else %}{{ store.name }} — خير الجوار{% endif %}
{% endblock %}

{% block content %}
{# ── Cinematic hero (v1.5) ── #}
<section class="ka-hero">
  <video
    class="ka-hero__video"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="{{ 'images/brand/hero-reel/warehouse.png'|asset_url }}"
  >
    <source src="{{ 'videos/hero.webm'|asset_url }}" type="video/webm" />
    <source src="{{ 'videos/hero.mp4'|asset_url }}" type="video/mp4" />
  </video>
  <img
    class="ka-hero__poster"
    src="{{ 'images/brand/hero-reel/warehouse.png'|asset_url }}"
    alt=""
    width="1280"
    height="720"
    hidden
  />
  <div class="ka-hero__wash" aria-hidden="true"></div>
  <div class="ka-hero__edge" aria-hidden="true"></div>

  <div class="ka-hero__grid ka-reveal">
    <div>
      <p class="ka-hero__eyebrow">{% if en %}From Jeddah{% else %}من جدة{% endif %}</p>
      <h1 class="ka-hero__title">
        {% if en %}Khair Aljaar{% else %}خير الجوار{% endif %}
      </h1>
      <p class="ka-hero__tagline">
        {% if en %}Neighborly goodness starts here{% else %}خير الجوار يبدأ هنا{% endif %}
      </p>
      <p class="ka-hero__lead">
        {% if en %}
          Premium produce from Jeddah — fresh, frozen, export-ready.
        {% else %}
          منتجات مميزة من جدة — طازجة ومجمدة وجاهزة للتصدير.
        {% endif %}
      </p>
      <div class="ka-hero__actions">
        <a class="ka-btn ka-btn--primary" href="/products">
          {% if en %}Request a quote{% else %}اطلب عرض سعر{% endif %}
        </a>
        <a class="ka-btn ka-btn--outline" href="/products">
          {% if en %}Products{% else %}المنتجات{% endif %}
        </a>
      </div>
    </div>
  </div>
</section>

{# ── Standards strip ── #}
<section class="ka-standards">
  <div class="ka-container">
    <p class="ka-standards__label">{% if en %}Trust & standards frame{% else %}إطار الثقة والمعايير{% endif %}</p>
    <div class="ka-standards__row">
      <span>{% if en %}SFDA-aligned{% else %}امتثال SFDA{% endif %}</span>
      <span>GLOBALG.A.P.</span>
      <span>{% if en %}Halal{% else %}حلال{% endif %}</span>
      <span>ISO 22000</span>
      <span>HACCP</span>
      <span>{% if en %}Jeddah Chamber{% else %}غرفة جدة{% endif %}</span>
    </div>
  </div>
</section>

{# ── Origin ── #}
<section class="ka-origin ka-section" id="about">
  <div class="ka-origin__float ka-origin__float--start ka-float">
    <img src="{{ 'images/brand/dates-isolated.webp'|asset_url }}" alt="" width="420" height="420" loading="lazy" />
  </div>
  <div class="ka-origin__float ka-origin__float--end ka-float-delay">
    <img src="{{ 'images/brand/oranges-isolated.webp'|asset_url }}" alt="" width="420" height="420" loading="lazy" />
  </div>
  <div class="ka-container">
    <div class="ka-section__center ka-reveal">
      <svg class="ka-leaf-icon" viewBox="0 0 72 88" fill="none" aria-hidden="true">
        <path d="M36 80C20 62 14 40 22 22C28 10 36 8 36 8s8 2 14 14c8 18 2 40-14 58Z" fill="#1A332A" fill-opacity=".12" stroke="#1A332A" stroke-width="1.5"/>
      </svg>
      <p class="ka-section__label">{% if en %}Khair Aljaar{% else %}خير الجوار{% endif %}</p>
      <h2 class="ka-section__title">
        {% if en %}A neighborly harvest.{% else %}خير الجوار يبدأ من جدة.{% endif %}
      </h2>
      <p class="ka-section__text">
        {% if en %}
          We source from trusted partner farms and coordinate export with care from Jeddah.
        {% else %}
          نورد من مزارع شريكة موثوقة وننسّق التصدير بعناية من جدة.
        {% endif %}
      </p>
      <a class="ka-btn ka-btn--primary" href="/page/about">
        {% if en %}Learn more{% else %}اعرف قصتنا{% endif %}
      </a>
    </div>
    <div class="ka-origin__strip">
      <img class="ka-float" src="{{ 'images/brand/dates-isolated.webp'|asset_url }}" alt="" loading="lazy" />
      <img class="ka-float-delay" src="{{ 'images/brand/oranges-isolated.webp'|asset_url }}" alt="" loading="lazy" />
    </div>
  </div>
</section>

{# ── Products ── #}
<section class="ka-section ka-section--soft" id="products">
  <svg class="ka-motif ka-float" style="top:3rem;inset-inline-start:1rem;width:70px;opacity:.22" viewBox="0 0 80 80" fill="none" aria-hidden="true">
    <circle cx="40" cy="42" r="26" fill="#1A332A" fill-opacity=".1" stroke="#1A332A" stroke-width="1.5"/>
  </svg>
  <div class="ka-container">
    <div class="ka-section__center">
      <p class="ka-section__label">{% if en %}Our products{% else %}المنتجات{% endif %}</p>
      <h2 class="ka-section__title">
        {% if en %}Made to be wanted.{% else %}منتجات تُطلب.{% endif %}
      </h2>
      <p class="ka-section__text">
        {% if en %}
          Studio-grade produce. Clear specs. Ready for wholesale inquiry.
        {% else %}
          تصوير استوديو احترافي. مواصفات واضحة. جاهزة لطلبات الجملة.
        {% endif %}
      </p>
    </div>

    <div class="ka-products">
      {% if products and products|length > 0 %}
        {% for product in products[:9] %}
          <a class="ka-card" href="{{ product.html_url|default('/products/' ~ product.slug|default(product.id)) }}">
            <div class="ka-card__media">
              {% if product.images and product.images|length > 0 %}
                <img src="{{ product.images[0].image.full_size|default(product.images[0].src|default(product.images[0])) }}" alt="{{ product.name }}" width="640" height="640" loading="lazy" />
              {% elif product.image %}
                <img src="{{ product.image }}" alt="{{ product.name }}" width="640" height="640" loading="lazy" />
              {% else %}
                <img src="{{ 'images/products/oranges.webp'|asset_url }}" alt="{{ product.name }}" width="640" height="640" loading="lazy" />
              {% endif %}
            </div>
            <div class="ka-card__body">
              <p class="ka-card__cat">{{ product.categories[0].name if product.categories else '' }}</p>
              <h3 class="ka-card__title">{{ product.name }}</h3>
            </div>
          </a>
        {% endfor %}
      {% else %}
        <a class="ka-card" href="/products">
          <div class="ka-card__media"><img src="{{ 'images/products/valencia-oranges.webp'|asset_url }}" alt="" loading="lazy" /></div>
          <div class="ka-card__body"><p class="ka-card__cat">{% if en %}Citrus{% else %}الموالح{% endif %}</p><h3 class="ka-card__title">{% if en %}Valencia Oranges{% else %}برتقال فالنسيا{% endif %}</h3></div>
        </a>
        <a class="ka-card" href="/products">
          <div class="ka-card__media"><img src="{{ 'images/products/navel-oranges.webp'|asset_url }}" alt="" loading="lazy" /></div>
          <div class="ka-card__body"><p class="ka-card__cat">{% if en %}Citrus{% else %}الموالح{% endif %}</p><h3 class="ka-card__title">{% if en %}Premium Navel Oranges{% else %}برتقال نافيل فاخر{% endif %}</h3></div>
        </a>
        <a class="ka-card" href="/products">
          <div class="ka-card__media"><img src="{{ 'images/products/medjool-dates.webp'|asset_url }}" alt="" loading="lazy" /></div>
          <div class="ka-card__body"><p class="ka-card__cat">{% if en %}Dates{% else %}التمور{% endif %}</p><h3 class="ka-card__title">{% if en %}Premium Medjool Dates{% else %}تمر مجدول فاخر{% endif %}</h3></div>
        </a>
        <a class="ka-card" href="/products">
          <div class="ka-card__media"><img src="{{ 'images/products/barhi-dates.webp'|asset_url }}" alt="" loading="lazy" /></div>
          <div class="ka-card__body"><p class="ka-card__cat">{% if en %}Dates{% else %}التمور{% endif %}</p><h3 class="ka-card__title">{% if en %}Barhi Fresh Dates{% else %}تمر برحي طازج{% endif %}</h3></div>
        </a>
        <a class="ka-card" href="/products">
          <div class="ka-card__media"><img src="{{ 'images/products/hass-avocados.webp'|asset_url }}" alt="" loading="lazy" /></div>
          <div class="ka-card__body"><p class="ka-card__cat">{% if en %}Fruits{% else %}الفواكه{% endif %}</p><h3 class="ka-card__title">{% if en %}Hass Avocados{% else %}أفوكادو هاس{% endif %}</h3></div>
        </a>
        <a class="ka-card" href="/products">
          <div class="ka-card__media"><img src="{{ 'images/products/pomegranates.webp'|asset_url }}" alt="" loading="lazy" /></div>
          <div class="ka-card__body"><p class="ka-card__cat">{% if en %}Fruits{% else %}الفواكه{% endif %}</p><h3 class="ka-card__title">{% if en %}Premium Pomegranates{% else %}رمان فاخر{% endif %}</h3></div>
        </a>
        <a class="ka-card" href="/products">
          <div class="ka-card__media"><img src="{{ 'images/products/spunta-potatoes.webp'|asset_url }}" alt="" loading="lazy" /></div>
          <div class="ka-card__body"><p class="ka-card__cat">{% if en %}Vegetables{% else %}الخضروات{% endif %}</p><h3 class="ka-card__title">{% if en %}Spunta Table Potatoes{% else %}بطاطس سبونتا مائدة{% endif %}</h3></div>
        </a>
        <a class="ka-card" href="/products">
          <div class="ka-card__media"><img src="{{ 'images/products/red-onions.webp'|asset_url }}" alt="" loading="lazy" /></div>
          <div class="ka-card__body"><p class="ka-card__cat">{% if en %}Vegetables{% else %}الخضروات{% endif %}</p><h3 class="ka-card__title">{% if en %}Red Onions{% else %}بصل أحمر{% endif %}</h3></div>
        </a>
        <a class="ka-card" href="/products">
          <div class="ka-card__media"><img src="{{ 'images/products/kent-mangoes.webp'|asset_url }}" alt="" loading="lazy" /></div>
          <div class="ka-card__body"><p class="ka-card__cat">{% if en %}Fruits{% else %}الفواكه{% endif %}</p><h3 class="ka-card__title">{% if en %}Kent Mangoes{% else %}مانجو كينت{% endif %}</h3></div>
        </a>
        <a class="ka-card" href="/products">
          <div class="ka-card__media"><img src="{{ 'images/products/fresh-garlic.webp'|asset_url }}" alt="" loading="lazy" /></div>
          <div class="ka-card__body"><p class="ka-card__cat">{% if en %}Vegetables{% else %}الخضروات{% endif %}</p><h3 class="ka-card__title">{% if en %}Fresh Garlic{% else %}ثوم طازج{% endif %}</h3></div>
        </a>
        <a class="ka-card" href="/products">
          <div class="ka-card__media"><img src="{{ 'images/products/frozen-strawberries.webp'|asset_url }}" alt="" loading="lazy" /></div>
          <div class="ka-card__body"><p class="ka-card__cat">{% if en %}Frozen{% else %}المجمدات{% endif %}</p><h3 class="ka-card__title">{% if en %}IQF Frozen Strawberries{% else %}فراولة مجمدة IQF{% endif %}</h3></div>
        </a>
        <a class="ka-card" href="/products">
          <div class="ka-card__media"><img src="{{ 'images/products/frozen-mixed-vegetables.webp'|asset_url }}" alt="" loading="lazy" /></div>
          <div class="ka-card__body"><p class="ka-card__cat">{% if en %}Frozen{% else %}المجمدات{% endif %}</p><h3 class="ka-card__title">{% if en %}IQF Mixed Vegetables{% else %}خضروات مشكلة مجمدة{% endif %}</h3></div>
        </a>
      {% endif %}
    </div>

    <div class="ka-section__center" style="margin-top:2.5rem">
      <a class="ka-btn ka-btn--primary" href="/products">
        {% if en %}View full catalog{% else %}عرض الكتالوج كاملًا{% endif %}
      </a>
    </div>
  </div>
</section>

{# ── Editorial trust ── #}
<section class="ka-section" id="editorial">
  <div class="ka-container">
    <div class="ka-section__center">
      <p class="ka-section__label">{% if en %}From farm to table{% else %}من المزرعة إلى المائدة{% endif %}</p>
      <h2 class="ka-section__title">
        {% if en %}Quiet confidence.{% else %}ثقة بهدوء.{% endif %}
      </h2>
      <p class="ka-section__text">
        {% if en %}
          Cold-chain discipline, export documentation, and partner-first service — without the noise.
        {% else %}
          سلسلة تبريد منضبطة، وثائق تصدير، وخدمة تضع الشريك أولًا — بلا ضجيج.
        {% endif %}
      </p>
    </div>
    <article class="ka-editorial">
      <div class="ka-editorial__media">
        <img
          src="{{ 'images/brand/editorial-board.webp'|asset_url }}"
          alt="{% if en %}Harvest board{% else %}لوحة الحصاد{% endif %}"
          width="840"
          height="1050"
          loading="lazy"
        />
      </div>
      <div class="ka-editorial__body">
        <p class="ka-editorial__cat">{% if en %}HARVEST · EDITORIAL{% else %}حصاد · تحريري{% endif %}</p>
        <h3 class="ka-editorial__title">{% if en %}Harvest board{% else %}لوحة الحصاد{% endif %}</h3>
      </div>
    </article>
  </div>
</section>

{# ── Trust pillars strip ── #}
<section class="ka-proof">
  <div class="ka-container">
    <div class="ka-proof__head">
      <div>
        <p class="ka-section__label">{% if en %}Quiet confidence{% else %}ثقة بهدوء{% endif %}</p>
        <h2 class="ka-section__title" style="font-size:clamp(1.6rem,3vw,2.4rem);text-align:start;margin:0">
          {% if en %}Four pillars partners can lean on.{% else %}أربعة أعمدة يعتمد عليها الشريك.{% endif %}
        </h2>
      </div>
      <a class="ka-link" href="/page/quality">{% if en %}Quality system →{% else %}نظام الجودة ←{% endif %}</a>
    </div>
    <div class="ka-proof__grid">
      <article>
        <strong>{% if en %}Quality care{% else %}عناية بالجودة{% endif %}</strong>
        <p>{% if en %}Graded lots, packing integrity, export-minded specs.{% else %}دفعات مفرزة وتعبئة سليمة ومواصفات تصدير.{% endif %}</p>
      </article>
      <article>
        <strong>{% if en %}Cold chain{% else %}سلسلة التبريد{% endif %}</strong>
        <p>{% if en %}Temperature-minded handling from hub to destination.{% else %}مناولة تراعي الحرارة من المركز إلى الوجهة.{% endif %}</p>
      </article>
      <article>
        <strong>{% if en %}Documentation{% else %}وثائق{% endif %}</strong>
        <p>{% if en %}Origin, packing lists, and partner-ready paperwork.{% else %}منشأ وقوائم تعبئة وأوراق جاهزة للشريك.{% endif %}</p>
      </article>
      <article>
        <strong>{% if en %}Jeddah hub{% else %}مركز جدة{% endif %}</strong>
        <p>{% if en %}Red Sea logistics base for GCC and beyond.{% else %}قاعدة لوجستية على البحر الأحمر للخليج وما بعده.{% endif %}</p>
      </article>
    </div>
  </div>
</section>

{# ── Export docs ── #}
<section class="ka-docs" id="export-docs">
  <div class="ka-container">
    <div class="ka-section__center" style="margin-bottom:1.5rem">
      <p class="ka-section__label">{% if en %}Export readiness{% else %}جاهزية التصدير{% endif %}</p>
      <h2 class="ka-section__title" style="font-size:clamp(1.4rem,3vw,2rem)">
        {% if en %}Documents and support importers expect.{% else %}وثائق ودعم يحتاجه المستورد.{% endif %}
      </h2>
    </div>
    <div class="ka-docs__grid">
      <article class="ka-docs__card">
        <strong>{% if en %}Commercial docs{% else %}وثائق تجارية{% endif %}</strong>
        <p>{% if en %}Invoice, packing list, and Certificate of Origin as required.{% else %}فاتورة وقائمة تعبئة وشهادة منشأ حسب الطلب.{% endif %}</p>
      </article>
      <article class="ka-docs__card">
        <strong>{% if en %}Quality pack{% else %}حزمة الجودة{% endif %}</strong>
        <p>{% if en %}Grade specs, lot notes, and partner-ready paperwork.{% else %}مواصفات الدرجة وملاحظات الدفعات وأوراق جاهزة للشريك.{% endif %}</p>
      </article>
      <article class="ka-docs__card">
        <strong>{% if en %}Cold-chain notes{% else %}ملاحظات التبريد{% endif %}</strong>
        <p>{% if en %}Temperature-minded handling for chilled and frozen lines.{% else %}مناولة تراعي الحرارة للخطوط المبردة والمجمدة.{% endif %}</p>
      </article>
      <article class="ka-docs__card">
        <strong>{% if en %}Shipping support{% else %}دعم الشحن{% endif %}</strong>
        <p>{% if en %}FOB Jeddah by default; CIF/CFR by lane and volume.{% else %}FOB جدة افتراضيًا؛ CIF/CFR حسب المسار والحجم.{% endif %}</p>
      </article>
    </div>
  </div>
</section>

{# ── FAQ ── #}
<section class="ka-faq" id="faq">
  <div class="ka-container" style="max-width:760px">
    <div class="ka-section__center" style="margin-bottom:1.25rem">
      <p class="ka-section__label">{% if en %}FAQ{% else %}أسئلة شائعة{% endif %}</p>
      <h2 class="ka-section__title" style="font-size:clamp(1.4rem,3vw,2rem)">
        {% if en %}Quick answers for trading partners.{% else %}إجابات سريعة للشركاء.{% endif %}
      </h2>
    </div>
    <details open>
      <summary>{% if en %}What is the minimum order?{% else %}ما الحد الأدنى للطلب؟{% endif %}</summary>
      <p>{% if en %}Most lines start from 1 MT or 1 container. Exact MOQ is confirmed on quote.{% else %}معظم الخطوط تبدأ من طن أو حاوية. الحد الأدنى يُؤكد في عرض السعر.{% endif %}</p>
    </details>
    <details>
      <summary>{% if en %}Which Incoterms do you offer?{% else %}ما شروط الشحن المتوفرة؟{% endif %}</summary>
      <p>{% if en %}FOB Jeddah is default. CIF, CFR, EXW, and DAP can be quoted by destination.{% else %}FOB جدة افتراضي. يمكن تسعير CIF وCFR وEXW وDAP حسب الوجهة.{% endif %}</p>
    </details>
    <details>
      <summary>{% if en %}Are listed prices final?{% else %}هل الأسعار المعروضة نهائية؟{% endif %}</summary>
      <p>{% if en %}No — index prices are indicative and subject to confirmation.{% else %}لا — الأسعار استرشادية وتخضع للتأكيد.{% endif %}</p>
    </details>
  </div>
</section>

{# ── Pillars ── #}
<section class="ka-section ka-section--green" id="pillars">
  <div class="ka-container">
    <div class="ka-section__center">
      <h2 class="ka-section__title">
        {% if en %}Khair Aljaar is shaping trusted food trade.{% else %}خير الجوار يصنع مستقبل الغذاء.{% endif %}
      </h2>
    </div>
    <div class="ka-pillars">
      <div class="ka-pillar">
        <svg class="ka-pillar__icon ka-float" viewBox="0 0 72 88" fill="none" aria-hidden="true"><path d="M36 80C20 62 14 40 22 22C28 10 36 8 36 8s8 2 14 14c8 18 2 40-14 58Z" fill="#F7F4EC" fill-opacity=".15" stroke="#F7F4EC" stroke-width="1.5"/></svg>
        <h3>{% if en %}Quality{% else %}الجودة{% endif %}</h3>
        <p>{% if en %}Certified care in every carton.{% else %}عناية معتمدة في كل كرتونة.{% endif %}</p>
        <a href="/page/quality">{% if en %}Explore{% else %}استكشف{% endif %}</a>
      </div>
      <div class="ka-pillar">
        <svg class="ka-pillar__icon ka-float-delay" viewBox="0 0 40 100" fill="none" aria-hidden="true"><path d="M20 96C18 70 10 52 20 28C28 10 26 4 20 2" stroke="#F7F4EC" stroke-width="1.5"/></svg>
        <h3>{% if en %}Cold chain{% else %}سلسلة التبريد{% endif %}</h3>
        <p>{% if en %}Temperature-minded handling to port.{% else %}مناولة تراعي الحرارة حتى الميناء.{% endif %}</p>
        <a href="/page/logistics">{% if en %}Explore{% else %}استكشف{% endif %}</a>
      </div>
      <div class="ka-pillar">
        <svg class="ka-pillar__icon ka-float" viewBox="0 0 90 90" fill="none" aria-hidden="true"><path d="M45 78V42M45 48c-14-6-22-18-24-30M45 52c14-6 22-18 24-30" stroke="#F7F4EC" stroke-width="1.55"/></svg>
        <h3>{% if en %}Jeddah hub{% else %}مركز جدة{% endif %}</h3>
        <p>{% if en %}Export logistics rooted in Jeddah.{% else %}لوجستيات تصدير من جدة.{% endif %}</p>
        <a href="/page/about">{% if en %}Explore{% else %}استكشف{% endif %}</a>
      </div>
      <div class="ka-pillar">
        <svg class="ka-pillar__icon ka-float-delay" viewBox="0 0 72 72" fill="none" aria-hidden="true"><circle cx="28" cy="40" r="12" stroke="#F7F4EC" stroke-width="1.4"/><circle cx="44" cy="36" r="11" stroke="#F7F4EC" stroke-width="1.4"/></svg>
        <h3>{% if en %}Neighborly{% else %}الجوار{% endif %}</h3>
        <p>{% if en %}Hospitality and clarity in every shipment.{% else %}ضيافة ووضوح في كل شحنة.{% endif %}</p>
        <a href="/page/contact">{% if en %}Contact{% else %}تواصل{% endif %}</a>
      </div>
    </div>
  </div>
</section>

{# ── Closer ── #}
<section class="ka-section ka-section--green ka-closer" id="closer">
  <div class="ka-closer__orb ka-breathe" aria-hidden="true"></div>
  <div class="ka-container" style="position:relative;z-index:2">
    <p class="ka-section__label">{% if en %}Neighborly Batch{% else %}دفعة الجوار{% endif %}</p>
    <h2 class="ka-section__title">
      {% if en %}Ready when you are.{% else %}جاهزون عندما تكون جاهزًا.{% endif %}
    </h2>
    <p class="ka-section__text" style="margin-inline:auto;max-width:28rem">
      {% if en %}
        Request a quote or reach us in Jeddah — clear answers, trusted care.
      {% else %}
        اطلب عرض سعر أو تواصل معنا من جدة — وضوح وثقة.
      {% endif %}
    </p>
    <div class="ka-closer__actions">
      <a class="ka-btn ka-btn--primary" href="/products">{% if en %}Shop now{% else %}تسوق الآن{% endif %}</a>
