{% set en = store.language == 'en' %}
<header class="ka-header">
  <div class="ka-container ka-header__inner">
    <nav class="ka-nav ka-nav--start" aria-label="{% if en %}Primary{% else %}رئيسي{% endif %}">
      <a href="/products">{% if en %}Products{% else %}المنتجات{% endif %}</a>
      <a href="{{ url_for('pages', slug='about') }}">{% if en %}About{% else %}من نحن{% endif %}</a>
      <a href="/#partners">{% if en %}Partners{% else %}شركاؤنا{% endif %}</a>
    </nav>

    <a class="ka-brand" href="/">
      <img
        src="{{ 'images/khair-aljaar-mark.svg'|asset_url }}"
        alt="{{ store.name }}"
        width="40"
        height="40"
      />
      <span class="ka-brand__text">
        <strong>{% if en %}Khair Aljaar{% else %}خير الجوار{% endif %}</strong>
        <span>{% if en %}Neighborly goodness — from Jeddah to the world{% else %}خير الجوار… من جدة إلى العالم{% endif %}</span>
      </span>
    </a>

    <div class="ka-nav ka-nav--end">
      <a href="{{ url_for('pages', slug='quality') }}">{% if en %}Quality{% else %}الجودة{% endif %}</a>
      <a href="{{ url_for('pages', slug='logistics') }}">{% if en %}Logistics{% else %}اللوجستيات{% endif %}</a>
      <a href="{{ url_for('pages', slug='contact') }}">{% if en %}Contact{% else %}اتصل بنا{% endif %}</a>
      <div class="ka-header__settings">
        {% if en %}
          <a class="ka-lang-circle" href="?lang=ar" hreflang="ar">ع</a>
        {% else %}
          <a class="ka-lang-circle" href="?lang=en" hreflang="en">EN</a>
        {% endif %}
        <a class="ka-nav__quote" href="{{ url_for('pages', slug='contact') }}">{% if en %}Request quote{% else %}اطلب عرض سعر{% endif %}</a>
      </div>
    </div>

    <div class="ka-header__tools">
      {% if en %}
        <a class="ka-lang-circle ka-lang-circle--on-dark" href="?lang=ar" hreflang="ar">ع</a>
      {% else %}
        <a class="ka-lang-circle ka-lang-circle--on-dark" href="?lang=en" hreflang="en">EN</a>
      {% endif %}
      <button class="ka-menu-toggle" type="button" aria-label="{% if en %}Menu{% else %}القائمة{% endif %}" data-ka-menu>
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="ka-mobile-nav" data-ka-mobile hidden>
    <a href="/products">{% if en %}Products{% else %}المنتجات{% endif %}</a>
    <a href="{{ url_for('pages', slug='about') }}">{% if en %}About{% else %}من نحن{% endif %}</a>
    <a href="/#partners">{% if en %}Partners{% else %}شركاؤنا{% endif %}</a>
    <a href="{{ url_for('pages', slug='quality') }}">{% if en %}Quality{% else %}الجودة{% endif %}</a>
    <a href="{{ url_for('pages', slug='logistics') }}">{% if en %}Logistics{% else %}اللوجستيات{% endif %}</a>
    <a href="{{ url_for('pages', slug='contact') }}">{% if en %}Contact{% else %}اتصل بنا{% endif %}</a>
    <a class="ka-mobile-nav__quote" href="{{ url_for('pages', slug='contact') }}">{% if en %}Request a quote{% else %}اطلب عرض سعر{% endif %}</a>
    <a href="/cart">{% if en %}Cart{% else %}السلة{% endif %}</a>
  </div>
</header>
